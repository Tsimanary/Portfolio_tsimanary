---
const { href } = Astro.props;
---

<a
    target="_blank"
    href={href}
    class="inline-flex bg-neutral-100 text-neutral-800 border-neutral-300 items-center justify-center gap-2 px-3 py-2 space-x-2 text-base transition dark:text-white dark:bg-neutral-800 border dark:border-neutral-600 focus-visible:ring-yellow-500/80 text-md hover:bg-neutral-800 hover:border-neutral-900 group max-w-fit rounded-xl hover:text-white focus:outline-none focus-visible:outline-none focus-visible:ring focus-visible:ring-white focus-visible:ring-offset-2 active:bg-black"
>
    <slot />
</a>
