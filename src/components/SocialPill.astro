---
const { href = "", ...rest } = Astro.props;
// Nouvel onglet uniquement pour les liens externes
const external = /^https?:\/\//.test(href);
---

<a
  href={href}
  {...rest}
  {...external ? { target: "_blank", rel: "noopener noreferrer" } : {}}
  data-magnetic
  class="inline-flex items-center justify-center gap-2 px-4 py-1 text-neutral-800 transition-colors bg-neutral-100 border border-neutral-300 rounded-full dark:bg-neutral-800 dark:border-neutral-600 dark:text-white focus-visible:ring-yellow-500/80 text-md hover:bg-neutral-900 hover:border-neutral-700 hover:text-white dark:hover:bg-neutral-100 dark:hover:border-neutral-300 dark:hover:text-black group max-w-fit focus:outline-none focus-visible:outline-none focus-visible:ring focus-visible:ring-white focus-visible:ring-offset-2 active:bg-black"
>
  <slot />
</a>
