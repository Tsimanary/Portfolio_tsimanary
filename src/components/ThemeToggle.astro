---
import SunIcon from "./icons/Sun.astro"
import MoonIcon from "./icons/Moon.astro"
---

<!-- Bouton unique comme kstoimenov : soleil en mode sombre, lune en mode clair -->
<button
  transition:persist
  id="theme-toggle-btn"
  type="button"
  class="theme-toggle"
  aria-label="Basculer entre le mode clair et le mode sombre"
>
  <SunIcon class="icon-sun size-5" />
  <MoonIcon class="icon-moon size-5" />
</button>

<style>
  .theme-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border: none;
    border-radius: 8px;
    background: rgba(17, 17, 17, 0.06);
    color: inherit;
    cursor: pointer;
    transition: background 0.2s, transform 0.2s;
  }
  .theme-toggle:hover {
    background: var(--accent-soft);
    transform: rotate(-12deg);
  }
  :global(html.dark) .theme-toggle {
    background: rgba(255, 255, 255, 0.07);
  }
  :global(html.dark) .theme-toggle :global(.icon-moon),
  :global(html:not(.dark)) .theme-toggle :global(.icon-sun) {
    display: none;
  }
</style>

<script>
  const THEME_STORAGE_KEY = "theme"
  const media = window.matchMedia("(prefers-color-scheme: dark)")

  const readPreference = (): string | null => {
    try {
      return localStorage.getItem(THEME_STORAGE_KEY)
    } catch {
      return null
    }
  }

  // Sans choix explicite, on suit le réglage du système
  const applyTheme = (): void => {
    const pref = readPreference()
    const isDark = pref === "dark" || ((pref === null || pref === "system") && media.matches)
    document.documentElement.classList.toggle("dark", isDark)
  }

  applyTheme()
  media.addEventListener("change", applyTheme)

  document.addEventListener("click", (e) => {
    if (!(e.target as HTMLElement).closest("#theme-toggle-btn")) return
    const nextIsDark = !document.documentElement.classList.contains("dark")
    try {
      localStorage.setItem(THEME_STORAGE_KEY, nextIsDark ? "dark" : "light")
    } catch {}
    applyTheme()
  })

  document.addEventListener("astro:after-swap", applyTheme)
</script>
