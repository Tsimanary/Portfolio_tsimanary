---
const personalImageAlt = "TSIMANARY Andriniaina Bonheur";
import Badge from "@/components/Badge.astro";
import SparklesIcon from "@/components/icons/Sparkles.astro";
---

<div
  class="anim-fade-in flex flex-col md:flex-row gap-6 mb-6 items-center md:items-start"
>
  <!-- Avatar -->
  <div class="relative flex-shrink-0">
    <div
      class="absolute inset-0 rounded-full bg-green-400/30 dark:bg-green-400/20 blur-xl scale-125 animate-pulse-glow"
      aria-hidden="true"
    >
    </div>
    <img
      class="avatar-ring relative rounded-full shadow-2xl w-40 h-40 xl:w-52 xl:h-52 object-cover object-top ring-2 ring-offset-2 transition-transform duration-300 hover:scale-110 ring-offset-[#0b4a1a]"
      src="/projects/me-480.jpg"
      width="208"
      height="208"
      fetchpriority="high"
      alt={personalImageAlt}
    />
  </div>

  <!-- Texte -->
  <div class="text-center md:text-left md:flex-1">
    <a
      href="#contact"
      class="flex items-center justify-center md:justify-start transition md:hover:scale-105 mb-4"
    >
      <Badge><SparklesIcon class="size-3" /> Disponible pour une embauche</Badge
      >
    </a>
    <h1 class="hero-title font-display text-white">
      <span class="line"><span class="hero-kicker">Salut, je suis</span></span>
      <span class="line"><span class="hero-name gradient-name">TSIMANARY</span></span>
    </h1>
    <p class="hero-role anim-fade-in anim-delay-2">
      Développeur Full-Stack <span aria-hidden="true">—</span> web, mobile &amp; cloud
    </p>
    <p class="hero-text anim-fade-in anim-delay-2 mt-5 max-w-3xl text-lg md:text-xl xl:text-2xl text-pretty">
      Développeur Full Stack passionné, je conçois et réalise des applications
      web et mobile performantes et évolutives avec
      <strong>
        Laravel, React, Flutter, Flask, Django et Node.js
      </strong>. À l'aise avec les environnements modernes de déploiement, je
      maîtrise
      <strong>
        Docker, Kubernetes et Google Cloud
      </strong>
      pour livrer des solutions robustes et scalables.
    </p>
  </div>
</div>

<style>
  /* === Avatar === */
  html.dark .avatar-glow {
    background: rgba(92, 246, 92, 0.3);
  }
  .avatar-glow {
    background: rgba(21, 128, 61, 0.25);
  }
  .avatar-ring {
    --tw-ring-color: rgba(92, 246, 143, 0.55);
  }

  /* === Nom dégradé === */
  /* Le Hero est sur le verre vert dans les deux modes : nom blanc → menthe */
  .gradient-name {
    background: linear-gradient(90deg, #ffffff 30%, #d9ffe0 70%, #a7f3d0);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  /* === Titre éditorial === */
  .hero-title {
    margin: 0;
    font-weight: 700;
    line-height: 0.95;
    letter-spacing: -0.03em;
  }
  .hero-title .line {
    display: block;
    overflow: hidden;
    padding-bottom: 0.08em;
  }
  .hero-title .line > span {
    display: inline-block;
    animation: line-up 1s cubic-bezier(0.7, 0, 0.2, 1) both;
  }
  .hero-title .line:nth-child(2) > span {
    animation-delay: 0.12s;
  }
  .hero-kicker {
    font-size: clamp(1.5rem, 3vw, 2.75rem);
    font-weight: 500;
    letter-spacing: -0.01em;
  }
  .hero-name {
    font-size: clamp(3.25rem, 9vw, 8.5rem);
  }
  .hero-role {
    margin-top: 1rem;
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #ffffff;
    text-shadow:
      0 1px 2px rgba(0, 25, 8, 0.7),
      0 0 18px rgba(0, 25, 8, 0.55);
  }
  /* Sur le fond vert lumineux (clair comme sombre) : texte blanc, mots clés en menthe */
  /* Ombre courte (netteté des lettres) + ombre large (assombrit le halo derrière le texte) */
  .hero-text {
    color: #ffffff;
    font-weight: 500;
    text-shadow:
      0 1px 2px rgba(0, 25, 8, 0.65),
      0 0 22px rgba(0, 25, 8, 0.5);
  }
  .hero-text strong {
    color: #ffffff;
    font-weight: 800;
  }
  @keyframes line-up {
    from {
      transform: translateY(105%);
    }
    to {
      transform: translateY(0);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-title .line > span {
      animation: none;
    }
  }

</style>
