---
import ThemeToggle from "./ThemeToggle.astro";
import RollText from "./RollText.astro";

const navItems = [
  { title: "Expérience", label: "experience", url: "/#experience" },
  { title: "Projets", label: "projets", url: "/#projets" },
  { title: "Sur moi", label: "about-me", url: "/#about-me" },
  { title: "CV", label: "cv", url: "/Tsimanary-CV.pdf" },
];
---

<!-- Barre de navigation flottante en bas de l'écran, comme kstoimenov.com -->
<header class="site-nav-wrap">
  <nav class="site-nav" aria-label="Navigation principale">
    <ThemeToggle />
    {
      navItems.map((link) => (
        <a
          class:list={["nav-link", { "nav-link-cv": link.label === "cv" }]}
          data-section-link={link.label}
          href={link.url}
          {...(link.url.endsWith(".pdf")
            ? { download: "Tsimanary-CV.pdf" }
            : {})}
        >
          <RollText text={link.title} />
        </a>
      ))
    }
    <a href="/#contact" class="nav-link nav-cta" data-section-link="contact">
      <RollText text="Contact" />
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M7 7h10v10"></path><path d="M7 17 17 7"></path>
      </svg>
    </a>
  </nav>
</header>

<script>
  // Met en surbrillance le lien de la section visible à l'écran
  document.addEventListener("astro:page-load", () => {
    const sections = document.querySelectorAll<HTMLElement>("main section[id]");
    const links = document.querySelectorAll<HTMLAnchorElement>("[data-section-link]");

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          links.forEach((link) => {
            const active = link.dataset.sectionLink === entry.target.id;
            link.classList.toggle("is-active", active);
            if (active) link.setAttribute("aria-current", "true");
            else link.removeAttribute("aria-current");
          });
        });
      },
      { rootMargin: "-40% 0px -55% 0px" },
    );

    sections.forEach((section) => observer.observe(section));
    document.addEventListener("astro:before-swap", () => observer.disconnect(), {
      once: true,
    });
  });
</script>

<style>
  .site-nav-wrap {
    position: fixed;
    left: 50%;
    bottom: 1.25rem;
    z-index: 30;
    transform: translateX(-50%);
    max-width: calc(100vw - 1rem);
  }
  .site-nav {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.4rem;
    border-radius: 14px;
    border: 1px solid rgba(17, 17, 17, 0.1);
    background: rgba(255, 255, 255, 0.82);
    color: #111111;
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.25);
  }
  :global(html.dark) .site-nav {
    border-color: rgba(255, 255, 255, 0.1);
    background: rgba(17, 17, 17, 0.82);
    color: #ffffff;
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.45rem 0.9rem;
    border-radius: 9px;
    font-size: 15px;
    font-weight: 500;
    white-space: nowrap;
    color: inherit;
    text-decoration: none;
    transition: background 0.2s, color 0.2s;
  }
  .nav-link:hover,
  .nav-link.is-active {
    color: var(--accent);
  }
  .nav-link.is-active {
    background: var(--accent-soft);
  }
  .nav-cta svg {
    width: 1rem;
    height: 1rem;
  }

  @media (max-width: 520px) {
    .site-nav-wrap {
      bottom: 0.75rem;
    }
    .site-nav {
      gap: 0;
      padding: 0.3rem;
    }
    .nav-link {
      padding: 0.45rem 0.5rem;
      font-size: 13px;
    }
  }
  /* Très petits écrans : le CV reste accessible depuis les tuiles du pied de page */
  @media (max-width: 420px) {
    .nav-link-cv {
      display: none;
    }
  }
</style>
