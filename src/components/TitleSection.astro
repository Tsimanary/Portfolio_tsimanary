---
// const { className } = Astro.props;
---

<div
  data-reveal
  class="section-title font-display flex items-center gap-3 text-2xl font-bold tracking-tight mb-6 pb-3 border-b"
>
  <slot />
</div>

<style>
  /* Mode clair */
  .section-title {
    color: #171717;
    border-color: rgba(21, 128, 61, 0.15);
  }
  /* Les icônes SVG héritent la couleur du parent via currentColor */
  .section-title :global(svg) {
    color: #15803d;
  }

  /* Mode sombre */
  html.dark .section-title {
    color: #f5f5f5;
    border-color: rgba(92, 246, 131, 0.15);
  }
  html.dark .section-title :global(svg) {
    color: #8bfab9;
  }
</style>
