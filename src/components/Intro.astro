---
// Écran d'introduction (inspiré de kstoimenov.com) : compteur 0 → 100 %,
// nom qui apparaît lettre par lettre, puis rideau qui remonte.
// Affiché une seule fois par visite (sessionStorage) ; la classe intro-active / no-intro
// est posée sur <html> par le script du <head> dans Layout.astro, avant le premier rendu.
const name = "TSIMANARY";
const year = new Date().getFullYear();
---

<div id="intro" class="intro" aria-hidden="true">
  <div class="intro-glow"></div>

  <div class="intro-center">
    <p class="intro-name font-display">
      {
        name.split("").map((letter, i) => (
          <span class="intro-letter" style={`--d:${i * 70}ms`}>
            {letter}
          </span>
        ))
      }
    </p>
    <p class="intro-role">Développeur Full-Stack — web, mobile &amp; cloud</p>
  </div>

  <div class="intro-footer">
    <span class="intro-counter">[ <span class="intro-count">0</span> % ]</span>
    <span class="intro-meta">Portfolio — {year}</span>
  </div>
  <div class="intro-bar"><span></span></div>
</div>

<script is:inline>
  (function () {
    var root = document.documentElement;
    var el = document.getElementById("intro");
    if (!el) return;
    if (!root.classList.contains("intro-active")) {
      el.remove();
      return;
    }
    var num = el.querySelector(".intro-count");
    var bar = el.querySelector(".intro-bar span");
    var start = performance.now();
    var duration = 1800;

    function tick(now) {
      var t = Math.min(1, (now - start) / duration);
      var eased = 1 - Math.pow(1 - t, 3);
      num.textContent = String(Math.round(eased * 100));
      bar.style.transform = "scaleX(" + eased + ")";
      if (t < 1) requestAnimationFrame(tick);
      else setTimeout(finish, 250);
    }

    function finish() {
      el.classList.add("is-leaving");
      root.classList.remove("intro-active");
      try {
        sessionStorage.setItem("intro-seen", "1");
      } catch (e) {}
      document.dispatchEvent(new Event("intro:done"));
      setTimeout(function () {
        el.remove();
      }, 1100);
    }

    requestAnimationFrame(tick);
  })();
</script>

<style is:global>
  html.no-intro .intro {
    display: none;
  }
  /* Pas de défilement pendant l'intro, et les animations du Hero attendent la fin */
  html.intro-active,
  html.intro-active body {
    overflow: hidden;
  }
  html.intro-active :is(.anim-fade-in, .hero-title .line > span) {
    animation-play-state: paused;
  }

  .intro {
    position: fixed;
    inset: 0;
    z-index: 10000;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    background: #0d0f0e;
    color: #ffffff;
    overflow: hidden;
    transition:
      transform 1s cubic-bezier(0.76, 0, 0.24, 1),
      border-radius 1s cubic-bezier(0.76, 0, 0.24, 1);
  }
  html:not(.dark) .intro {
    background: #fafafa;
    color: #111111;
  }
  .intro.is-leaving {
    transform: translateY(-100%);
    border-bottom-left-radius: 50% 12vh;
    border-bottom-right-radius: 50% 12vh;
  }

  /* Lueur verte en bas, rappel du verre cannelé */
  .intro-glow {
    position: absolute;
    left: 50%;
    bottom: -35vh;
    width: 90vw;
    height: 60vh;
    transform: translateX(-50%);
    background: radial-gradient(closest-side, rgba(46, 227, 95, 0.45), transparent);
    filter: blur(40px);
    pointer-events: none;
  }

  .intro-center {
    position: relative;
    text-align: center;
  }
  .intro-name {
    display: flex;
    justify-content: center;
    margin: 0;
    font-size: clamp(3rem, 13vw, 9.5rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.02em;
    overflow: hidden;
  }
  .intro-letter {
    display: inline-block;
    transform: translateY(105%);
    animation: intro-letter-up 0.8s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    animation-delay: var(--d);
  }
  .intro-role {
    margin: 1.25rem 0 0;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    opacity: 0;
    animation: intro-fade 0.8s ease 0.7s forwards;
    color: #4ade80;
  }
  html:not(.dark) .intro-role {
    color: #15803d;
  }

  .intro-footer {
    position: absolute;
    left: 1.5rem;
    right: 1.5rem;
    bottom: 1.75rem;
    display: flex;
    justify-content: space-between;
    font-family: ui-monospace, "Cascadia Mono", Consolas, monospace;
    font-size: 14px;
    opacity: 0.8;
  }
  .intro-count {
    display: inline-block;
    min-width: 3ch;
    text-align: right;
    font-variant-numeric: tabular-nums;
  }
  .intro-bar {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 3px;
  }
  .intro-bar span {
    display: block;
    height: 100%;
    background: linear-gradient(90deg, #12e04f, #78e82a, #b8f7a0);
    transform: scaleX(0);
    transform-origin: left;
  }

  @keyframes intro-letter-up {
    to {
      transform: translateY(0);
    }
  }
  @keyframes intro-fade {
    to {
      opacity: 1;
    }
  }
</style>
